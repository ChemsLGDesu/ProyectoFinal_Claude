{
  "$schema": "https://ugs-config-schemas.unity3d.com/v1/matchmaker/matchmaker-queue.schema.json",
  "name": "quickmatch-queue",
  "enabled": true,
  "maxPlayersPerTicket": 1,
  "defaultPool": {
    "variants": [],
    "name": "quickmatch-pool",
    "enabled": true,
    "timeoutSeconds": 180,
    "matchLogic": {
      "name": "QuickmatchRules",
      "backfillEnabled": false,
      "matchDefinition": {
        "teams": [
          {
            "name": "Side",
            "teamCount": { "min": 2, "max": 2, "relaxations": [] },
            "playerCount": { "min": 1, "max": 1, "relaxations": [] },
            "teamRules": []
          }
        ],
        "matchRules": [
          {
            "source": "Players.CustomData.board_size",
            "name": "SameBoardSize",
            "type": "Equality",
            "not": false,
            "enableRule": true
          }
        ]
      }
    },
    "matchHosting": {
      "type": "MatchId"
    }
  },
  "filteredPools": []
}
