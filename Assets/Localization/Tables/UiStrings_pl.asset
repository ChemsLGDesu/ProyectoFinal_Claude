    m_Metadata:
      m_Items: []
  - m_Id: 33208397742090
    m_Localized: "\u25CC Offline"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742091
    m_Localized: "Podda\u0107 mecz?"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742092
    m_Localized: "Je\u015Bli teraz wyjdziesz, wygra Tw\xF3j rywal. Tej operacji nie
      mo\u017Cna cofn\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742093
    m_Localized: "Tw\xF3j rywal opu\u015Bci\u0142 mecz."
