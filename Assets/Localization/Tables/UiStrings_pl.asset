      m_Items: []
  - m_Id: 1799372835
    m_Localized: Seria
    m_Metadata:
      m_Items: []
  - m_Id: 1799372836
    m_Localized: "Historia mecz\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372837
    m_Localized: "Usu\u0144 moje dane"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372838
    m_Localized: "Usun\u0105\u0107 moje dane?"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372839
    m_Localized: "To trwale usunie Tw\xF3j lokalny post\u0119p, walut\u0119 i histori\u0119
      mecz\xF3w na tym urz\u0105dzeniu. Tej operacji nie mo\u017Cna cofn\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 1799372840
    m_Localized: "Usu\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372841
    m_Localized: "Historia mecz\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372842
    m_Localized: Wszystkie
    m_Metadata:
      m_Items: []
  - m_Id: 1799372843
    m_Localized: Solo
    m_Metadata:
      m_Items: []
  - m_Id: 1799372844
    m_Localized: Lokalnie
    m_Metadata:
      m_Items: []
  - m_Id: 1799372845
    m_Localized: "Brak mecz\xF3w. Zagraj, \u017Ceby zobaczy\u0107 je tutaj!"
